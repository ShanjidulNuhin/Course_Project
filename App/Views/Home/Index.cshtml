@model IEnumerable<Game.BLL.DTOs.GameDTO>

@{
    ViewData["Title"] = "Welcome to GameSP";
}

<div>
    <h2>Welcome to GameSP!</h2>
    <p>Explore and get your favorite games.</p>
    <hr />

    <h3>Available Games</h3>

    @if (Model == null || !Model.Any())
    {
        <p>No games available right now. Please check back later.</p>
    }
    else
    {
        <div class="game-grid">
            @foreach (var game in Model)
            {
                <div class="game-card">
                    @if (game.Cover != null && game.Cover.Length > 0)
                    {
                        var base64 = Convert.ToBase64String(game.Cover);
                        var imgSrc = $"data:image/jpeg;base64,{base64}";
                        <img src="@imgSrc" alt="@game.Title" class="game-card-img" />
                    }
                    else
                    {
                        <div class="game-card-no-img">
                            No Cover Image
                        </div>
                    }

                    <h4>@game.Title</h4>
                    <p>Genre: @game.Genre</p>
                    <div class="price">$@game.Price.ToString("N2")</div>
                    <p style="margin: 0;">
                        <a asp-controller="Home" asp-action="Details" asp-route-id="@game.Id" class="btn btn-wishlist" style="width: 100%; box-sizing: border-box;">View Details</a>
                    </p>
                </div>
            }
        </div>
    }
</div>