@model IEnumerable<Game.BLL.DTOs.UserDTO>
@{
    ViewData["Title"] = "Manage Users";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <title>Manage Users – GameSP Admin</title>
</head>
<body>
    <div style="display: flex; gap: 20px;">
        <div style="width: 200px; border-right: 1px solid #ccc; padding-right: 20px; display: flex; flex-direction: column; gap: 10px;">
            <h3>GameSP Admin</h3>
            <button onclick="window.location.href='/User/Index'" style="padding: 8px; cursor: pointer; text-align: left; background: #f0f0f0; border: 1px solid #ccc; border-radius: 4px; font-weight: bold; width: 100%;">Home</button>
            <button onclick="window.location.href='/Admin/Index'" style="padding: 8px; cursor: pointer; text-align: left; background: #f0f0f0; border: 1px solid #ccc; border-radius: 4px; font-weight: bold; width: 100%;">Dashboard</button>
            <button onclick="window.location.href='/Admin/Games'" style="padding: 8px; cursor: pointer; text-align: left; background: #f0f0f0; border: 1px solid #ccc; border-radius: 4px; font-weight: bold; width: 100%;">Manage Games</button>
            <button onclick="window.location.href='/Admin/AddGame'" style="padding: 8px; cursor: pointer; text-align: left; background: #f0f0f0; border: 1px solid #ccc; border-radius: 4px; font-weight: bold; width: 100%;">Add Game</button>
            <button onclick="window.location.href='/Admin/Users'" style="padding: 8px; cursor: pointer; text-align: left; background: #eff6ff; border: 1px solid #bfdbfe; border-radius: 4px; font-weight: bold; width: 100%; color: #4f46e5;">Manage Users</button>
            <hr style="margin: 5px 0; border: none; border-top: 1px solid #ccc; width: 100%;" />
            <button onclick="window.location.href='/Auth/Logout'" style="padding: 8px; cursor: pointer; text-align: left; background: #fee; border: 1px solid #ecc; border-radius: 4px; font-weight: bold; width: 100%; color: #c00;">Logout</button>
        </div>
        <div>
            @if (TempData["Success"] != null)
            {
                <p style="color: green; font-weight: bold;">@TempData["Success"]</p>
            }
            @if (TempData["Error"] != null)
            {
                <p style="color: red; font-weight: bold;">@TempData["Error"]</p>
            }

            <h2>User Management</h2>
            <p>@Model.Count() registered accounts</p>
            <hr />

            <table border="1" cellpadding="5" style="border-collapse: collapse; width: 100%;">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Balance</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in Model)
                    {
                        <tr>
                            <td>@user.Id</td>
                            <td><strong>@user.Name</strong></td>
                            <td>@user.Email</td>
                            <td>@user.Role</td>
                            <td>$@(user.Blance?.ToString("F2") ?? "0.00")</td>
                            <td>
                                @(user.IsActive == 1 ? "Active" : "Blocked")
                            </td>
                            <td>
                                @if (user.Role != "Admin")
                                {
                                    @if (user.IsActive == 1)
                                    {
                                        <form method="post" action="/Admin/BlockUser/@user.Id" style="display:inline;"
                                              onsubmit="return confirm('Block @user.Name?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit">Block</button>
                                        </form>
                                    }
                                    else
                                    {
                                        <form method="post" action="/Admin/UnblockUser/@user.Id" style="display:inline;">
                                            @Html.AntiForgeryToken()
                                            <button type="submit">Unblock</button>
                                        </form>
                                    }
                                    <span> | </span>
                                    <form method="post" action="/Admin/PromoteUser/@user.Id" style="display:inline;"
                                          onsubmit="return confirm('Promote @user.Name to Admin?');">
                                        @Html.AntiForgeryToken()
                                        <button type="submit">Promote</button>
                                    </form>
                                }
                                else
                                {
                                    <span>—</span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</body>
</html>
