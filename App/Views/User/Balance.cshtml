@{
    ViewData["Title"] = "Add Account Balance";
}
<div>
    <h2>Add Account Balance</h2>
    <p>Top up your wallet using mobile banking</p>
    <hr />
    @if (ViewBag.Error != null)
    {
        <p style="color: red; font-weight: bold;">@ViewBag.Error</p>
    }
    <form method="post" asp-controller="User" asp-action="AddBalance">
        <div>
            <label><strong>Select Mobile Payment Method (At least one):</strong></label>
            <br /><br />
            <div>
                <input type="checkbox" name="paymentMethods" value="bKash" id="chkBkash" />
                <label for="chkBkash">bKash (Instant top-up)</label>
            </div>
            <br />
            <div>
                <input type="checkbox" name="paymentMethods" value="Nagad" id="chkNagad" />
                <label for="chkNagad">Nagad (Safe and secure payments)</label>
            </div>
            <br />
            <div>
                <input type="checkbox" name="paymentMethods" value="Rocket" id="chkRocket" />
                <label for="chkRocket">Rocket (Fast & convenient)</label>
            </div>
        </div>
        <br />
        <div>
            <label><strong>Enter Amount ($):</strong></label>
            <br />
            <input type="number" name="amount" min="1" step="0.01" placeholder="0.00" required />
        </div>
        <br />
        <div>
            <button type="submit">Add Balance</button>
        </div>
    </form>
</div>