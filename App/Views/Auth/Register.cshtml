@model Game.BLL.DTOs.UserRegisterDTO

@{
    ViewData["Title"] = "Register";
}

<div>
    <h2>Register</h2>

    <form method="post">
        <div>
            <label>Name:</label><br />
            <input asp-for="Name" required />
        </div>
        <br />
        <div>
            <label>Email:</label><br />
            <input asp-for="Email" required />
        </div>
        <br />
        <div>
            <label>Password:</label><br />
            <input asp-for="Password" type="password" required />
        </div>
        <br />

        @if (ViewBag.AdminExists == false)
        {
            <div>
                <label>Role:</label><br />
                <select asp-for="Role">
                    <option value="Customer">Customer</option>
                    <option value="Admin">Admin</option>
                </select>
            </div>
            <br />
        }
        else
        {
            <input type="hidden" asp-for="Role" value="Customer" />
        }

        <button type="submit">Register</button>
    </form>

    @if (ViewBag.Error != null)
    {
        <p style="color: red; font-weight: bold;">@ViewBag.Error</p>
    }
</div>